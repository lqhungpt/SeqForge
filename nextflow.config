// =============================================================================
// Nextflow configuration — Genome Assembly Pipeline
// =============================================================================

manifest {
    name            = 'SeqForge'
    author          = 'hungluong'
    description     = 'SeqForge: portable short-read genome assembly pipeline'
    version         = '2.0.0'
    nextflowVersion = '>=23.0.0'
    mainScript      = 'main.nf'
}

// ---------------------------------------------------------------------------
// Default process settings
// ---------------------------------------------------------------------------
process {
    container = 'seqforge'

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'process_high' {
        cpus   = 6
        memory = '16 GB'
    }
}

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------
profiles {

    // Local Docker (macOS / Linux / Windows)
    docker {
        docker.enabled      = true
        docker.runOptions   = '--entrypoint ""'
        singularity.enabled = false
        process.container   = 'seqforge'
    }

    // Singularity (HPC clusters)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process.container      = 'docker://seqforge'
    }

    // SLURM cluster
    slurm {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://seqforge'

        withLabel: 'process_low' {
            cpus   = 2
            memory = '4 GB'
            time   = '1h'
        }
        withLabel: 'process_medium' {
            cpus   = 4
            memory = '8 GB'
            time   = '2h'
        }
        withLabel: 'process_high' {
            cpus   = 8
            memory = '32 GB'
            time   = '4h'
        }
    }

    // PBS cluster
    pbs {
        process.executor       = 'pbs'
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://seqforge'
    }

    // AWS Batch
    aws {
        process.executor = 'awsbatch'
        process.queue    = 'nextflow-queue'
        aws.region       = 'us-east-1'
        process.container = 'your-ecr-repo/seqforge:latest'
    }

    // Test profile — small dataset
    test {
        docker.enabled    = true
        process.container = 'seqforge'
        params {
            reads       = "${projectDir}/test_data/*_{R1,R2}.fastq.gz"
            reference   = "${projectDir}/test_data/reference.fasta"
            genome_size = 5000000
            outdir      = "test_results"
            threads     = 2
            depth       = 50
        }
    }
}

// ---------------------------------------------------------------------------
// Pipeline tracing and reporting
// ---------------------------------------------------------------------------
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,cpus,memory,disk,rss,vmem'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}
